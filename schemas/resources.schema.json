{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/schemas/resources.schema.json",
  "title": "SmartCarRace resources",
  "description": "全国大学生智能车竞赛资料导航站资源列表结构。",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "id",
      "title",
      "url",
      "year",
      "groups",
      "type",
      "topics",
      "level",
      "language",
      "description",
      "source",
      "tags",
      "featured",
      "createdAt",
      "updatedAt"
    ],
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
        "description": "资源稳定 ID，建议包含年份、类型和主题关键词。"
      },
      "title": {
        "type": "string",
        "minLength": 2
      },
      "url": {
        "type": "string",
        "format": "uri"
      },
      "year": {
        "type": "string",
        "pattern": "^[0-9]{4}$"
      },
      "groups": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": {
          "type": "string"
        }
      },
      "type": {
        "type": "string"
      },
      "topics": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": {
          "type": "string"
        }
      },
      "level": {
        "type": "string"
      },
      "language": {
        "type": "string",
        "examples": ["zh-CN", "en"]
      },
      "description": {
        "type": "string",
        "minLength": 8
      },
      "source": {
        "type": "object",
        "additionalProperties": false,
        "required": ["platform", "author"],
        "properties": {
          "platform": {
            "type": "string"
          },
          "author": {
            "type": "string"
          }
        }
      },
      "tags": {
        "type": "array",
        "uniqueItems": true,
        "items": {
          "type": "string"
        }
      },
      "featured": {
        "type": "boolean"
      },
      "createdAt": {
        "type": "string",
        "format": "date"
      },
      "updatedAt": {
        "type": "string",
        "format": "date"
      }
    }
  }
}
